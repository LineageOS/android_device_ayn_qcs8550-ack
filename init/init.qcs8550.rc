import /vendor/etc/init/hw/init.mainline.qcom.rc

on late-init
    write /sys/class/remoteproc/remoteproc0/state start
    write /sys/class/remoteproc/remoteproc1/state start

    exec u:r:modprobe:s0 -- /system/bin/modprobe -a -d /system_dlkm/lib/modules hci_uart.ko
    exec u:r:modprobe:s0 -- /system/bin/modprobe -a -d /system_dlkm/lib/modules cdc_eem.ko cdc_ether.ko cdc_ncm.ko

# Mount
on fs
    # Mount everything that does not require fsck
    mount_all --early

on late-fs
    # Mount RW partitions which need run fsck
    mount_all --late

on property:sys.boot_completed=1
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy3/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor schedutil
